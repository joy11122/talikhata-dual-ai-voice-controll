MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/talikhata?retryWrites=true&w=majority
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
AUTH_TRUST_HOST=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Configure either one or both. If both exist, OpenAI is primary and OpenRouter is automatic fallback.
OPENAI_API_KEY=
OPENAI_VOICE_MODEL=gpt-4.1-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
NEXT_PUBLIC_APP_URL=https://your-domain.com
CAP_SERVER_URL=https://your-domain.com
# Comma-separated emails that receive the ADMIN role on sign-in
ADMIN_EMAILS=admin@example.com

# Daily report scheduler (used by GitHub Actions)
DAILY_REPORT_CRON_SECRET=replace-with-a-long-random-secret
# Optional SMTP for free email delivery (e.g. Gmail SMTP with an app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
