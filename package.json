{
  "name": "talikhata-voice",
  "version": "2.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "cap:run:android": "npx cap run android",
    "cap:copy": "npx cap copy",
    "cap:update": "npx cap update",
    "test:voice": "vitest run tests/voice.test.ts tests/voice-accounting.test.ts",
    "qa": "npm run typecheck && npm run test && npm run build",
    "qa:routes": "node scripts/route-audit.mjs",
    "qa:static": "npm run typecheck && npm run qa:routes && npm run qa:structure && node scripts/qa-static.mjs",
    "qa:structure": "node scripts/structure-audit.mjs"
  },
  "dependencies": {
    "@auth/mongodb-adapter": "^3.10.1",
    "@hookform/resolvers": "^5.1.1",
    "bcryptjs": "^3.0.2",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.468.0",
    "mongoose": "^8.24.4",
    "next": "^14.2.35",
    "next-auth": "^5.0.0-beta.29",
    "openai": "^5.23.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.62.0",
    "zod": "^3.25.76",
    "mongodb": "^6.19.0",
    "@capacitor/core": "^7.4.3",
    "@capacitor/app": "^7.1.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/keyboard": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "@capacitor/android": "^7.4.3",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.21",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4",
    "@capacitor/cli": "^7.4.3"
  }
}
